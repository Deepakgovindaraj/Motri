{
  "name": "rideexpense-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vehixa REST API Backend (Express + TypeScript + MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
