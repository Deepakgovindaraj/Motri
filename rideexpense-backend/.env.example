# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/Riders

# JWT
JWT_ACCESS_SECRET=change-this-to-a-long-random-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-long-random-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Google OAuth (Phase 2 OAuth)
GOOGLE_CLIENT_ID=

# Cloudflare R2 Receipt Storage (Optional in local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rideexpense-receipts
R2_PUBLIC_URL=
